# Earthen Luxury Sutravan — local environment
# Copy this file to .env.local (gitignored) and fill in your Supabase project values.
#
# Only the anon key is shipped to the public client. It is safe-by-design:
# real authorization is enforced by Supabase Row Level Security (RLS), not by
# hiding the key. Find both values in your Supabase project:
#   Project Settings -> API -> Project URL + Project API keys (anon / public).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# SECURITY: The service_role key is a full-access secret. NEVER expose it through
# a build-inlined (VITE_-prefixed) variable, and NEVER commit it. Vite inlines
# every VITE_* var into the public bundle. The privileged key is only used by
# trusted server-side / one-off scripts, supplied at runtime via a plain env var
# named SUPABASE_SERVICE_ROLE_KEY (no build prefix).
